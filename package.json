{
  "name": "portfolio-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.mjs --configLoader native && node --test tests/database.test.mjs",
    "test:ui": "vitest run --config vitest.config.mjs --configLoader native",
    "test:database": "node --test tests/database.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
